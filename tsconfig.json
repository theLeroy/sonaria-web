{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "bundler",
    "typeRoots": [
      ".nuxt",
      "./app/types",
      "@nuxt/types",
      "@nuxt/i18n",
    ],
    "plugins": [
      {
        "name": "@0no-co/graphqlsp",
        "schema": "schema.graphql",
      }
    ]
  }
}
